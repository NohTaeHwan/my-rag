# BGE-M3 Embedding API 접속 정보 (예: DGX Spark Tailscale 주소)
# 실제 값은 .env 파일에만 넣고 커밋하지 않는다.
EMBEDDING_BASE_URL=http://<embedding-host>:8003/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# PostgreSQL 접속 정보. 로컬 docker-compose(rag-postgres)와 값을 맞춰야 한다.
DB_URL=jdbc:postgresql://127.0.0.1:5432/rag_db
DB_USERNAME=rag
DB_PASSWORD=<postgres-password>

# OpenAI-compatible LLM API 접속 정보 (예: DGX Spark Tailscale 주소)
# LLM_API_KEY는 실제 값을 .env 파일에만 넣고 커밋하지 않는다.
LLM_BASE_URL=http://<llm-host>:8002/v1
LLM_MODEL=<model-id>
LLM_API_KEY=<API-KEY>
