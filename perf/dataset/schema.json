{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RAG MVP perf query record",
  "type": "object",
  "required": [
    "query_id",
    "question",
    "category",
    "answer_type",
    "relevant_sources",
    "relevant_chunk_keys",
    "expected_facts",
    "unanswerable",
    "difficulty"
  ],
  "additionalProperties": false,
  "properties": {
    "query_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "category": {
      "type": "string",
      "enum": ["direct_lookup", "multi_chunk", "paraphrase", "keyword_identifier", "hard_negative", "unanswerable", "ambiguous"]
    },
    "answer_type": {
      "type": "string",
      "enum": ["extractive", "abstractive", "extractive_or_abstractive"]
    },
    "relevant_sources": {"type": "array", "items": {"type": "string"}},
    "relevant_chunk_keys": {"type": "array", "items": {"type": "string"}},
    "expected_facts": {"type": "array", "items": {"type": "string"}},
    "unanswerable": {"type": "boolean"},
    "difficulty": {"type": "string", "enum": ["easy", "medium", "hard"]}
  }
}
