# EXAMPLE — Spark의 ~/services/my-rag/config/my-rag.env 로 복사해서 실제 값을 채운다.
# 이 파일 자체(placeholder 버전)는 커밋해도 되지만, 실제 값이 채워진 my-rag.env는 절대 커밋하지 않는다.
# 권한: chmod 600 my-rag.env

DB_URL=jdbc:postgresql://127.0.0.1:5433/rag_db
DB_USERNAME=rag
DB_PASSWORD=<compose/.env의 DB_PASSWORD와 동일한 값>

EMBEDDING_BASE_URL=http://127.0.0.1:8003/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

LLM_BASE_URL=http://127.0.0.1:8002/v1
LLM_MODEL=<GET /v1/models 로 확인한 실제 서빙 모델 id>
LLM_API_KEY=<실제 LLM 서버 API Key, 없으면 비워둠>

# network_mode: host 컨테이너 안에서 쓸 포트. 8090 — Spark의 다른 프로젝트가 8080을 이미 쓰고 있어
# 충돌 회피 목적. 다른 환경에 배포할 때는 실제 포트 현황(sudo ss -lntp)을 먼저 확인한다.
SERVER_PORT=8090
